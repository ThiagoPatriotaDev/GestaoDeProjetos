<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background_light">
    <ScrollView android:id="@+id/mainScroll" android:layout_width="0dp" android:layout_height="0dp"
        android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/btnNovoProjeto"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp"
            android:paddingTop="22dp" android:paddingBottom="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:layout_width="46dp" android:layout_height="46dp"
                    android:background="@drawable/bg_brand_icon" android:padding="10dp"
                    android:src="@drawable/bg_logo_mark" android:contentDescription="Ícone UniFocus"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="UniFocus" android:textColor="@color/ink"
                        android:textSize="21sp" android:textStyle="bold" android:letterSpacing="-0.02" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="SEU ESPAÇO DE FOCO" android:textColor="@color/ink_secondary"
                        android:textSize="10sp" android:letterSpacing="0.16" />
                </LinearLayout>
                <TextView android:layout_width="40dp" android:layout_height="40dp"
                    android:background="@drawable/bg_purple_soft" android:gravity="center"
                    android:text="✦" android:textSize="22sp" android:textColor="@color/brand"/>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="30dp" android:text="Faça acontecer."
                android:textColor="@color/ink" android:textSize="30sp" android:textStyle="bold"
                android:letterSpacing="-0.035"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="Tudo o que importa, em um só lugar."
                android:textColor="@color/ink_secondary" android:textSize="14sp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_hero" android:orientation="vertical"
                android:layout_marginTop="26dp" android:padding="23dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="VISÃO GERAL" android:textSize="11sp"
                        android:letterSpacing="0.15" android:textStyle="bold" android:textColor="#B7ACFD" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="✦  EM TEMPO REAL" android:textSize="10sp" android:textColor="#E1DDFC"
                        android:background="@drawable/bg_hero_accent" android:paddingHorizontal="12dp" android:paddingVertical="8dp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="bottom" android:orientation="horizontal" android:layout_marginTop="20dp">
                    <TextView android:id="@+id/tvTotalProjetos" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0" android:textColor="@color/white"
                        android:textSize="54sp" android:textStyle="bold" android:letterSpacing="-0.06"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" android:layout_marginBottom="12dp"
                        android:text="projetos no total" android:textColor="#C5BFDF" android:textSize="13sp"/>
                </LinearLayout>
                <ProgressBar android:id="@+id/progressoProjetos" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="7dp" android:layout_marginTop="10dp"
                    android:max="100" android:progress="0" android:progressTint="#AE9FFF" android:progressBackgroundTint="#504875" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="21dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/tvAtivosDashboard" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textColor="@color/white" android:textSize="24sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Em andamento" android:textColor="#BDB6DD" android:textSize="12sp"/>
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="38dp" android:layout_marginHorizontal="16dp" android:background="#524978" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/tvConcluidosDashboard" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textColor="@color/white" android:textSize="24sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Concluídos" android:textColor="#BDB6DD" android:textSize="12sp"/>
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="38dp" android:layout_marginHorizontal="16dp" android:background="#524978" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/tvPrazosDashboard" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textColor="@color/white" android:textSize="24sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Precisam atenção" android:textColor="#BDB6DD" android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/fragmentDicaContainer"
                android:name="gestaodeprojetos.alunos.ui.DicaMotivacionalFragment"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" tools:layout="@layout/fragment_dica_motivacional" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="32dp" android:gravity="center_vertical" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Meus projetos" android:textColor="@color/ink"
                        android:textSize="22sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvSectionHint" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="O seu próximo passo começa aqui."
                        android:textColor="@color/ink_secondary" android:textSize="13sp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="18dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEmAndamento" android:layout_width="0dp" android:layout_height="43dp" android:layout_weight="1"
                    android:text="Em andamento" android:textAllCaps="false" android:textSize="12sp"
                    android:insetTop="0dp" android:insetBottom="0dp" android:backgroundTint="@color/brand"
                    app:cornerRadius="14dp" android:textColor="@color/white"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFinalizados" android:layout_width="0dp" android:layout_height="43dp" android:layout_weight="1"
                    android:layout_marginStart="10dp" android:text="Concluídos" android:textAllCaps="false"
                    android:textSize="12sp" android:insetTop="0dp" android:insetBottom="0dp"
                    android:backgroundTint="@color/white" app:cornerRadius="14dp" android:textColor="@color/ink_secondary"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/emptyProjects" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="16dp" android:padding="26dp"
                android:background="@drawable/bg_card_projeto" android:orientation="vertical" android:gravity="center"
                android:visibility="gone">
                <TextView android:layout_width="62dp" android:layout_height="62dp" android:gravity="center"
                    android:background="@drawable/bg_purple_soft" android:text="✦" android:textSize="31sp" android:textColor="@color/brand"/>
                <TextView android:id="@+id/tvEmptyTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Seu espaço está pronto" android:textColor="@color/ink" android:textSize="17sp"
                    android:textStyle="bold" android:gravity="center" android:layout_marginTop="18dp"/>
                <TextView android:id="@+id/tvEmptyDescription" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Crie seu primeiro projeto para começar." android:textColor="@color/ink_secondary"
                    android:textSize="13sp" android:gravity="center" android:layout_marginTop="7dp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/containerProjetos" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnNovoProjeto"
        android:layout_width="0dp" android:layout_height="58dp" android:layout_marginHorizontal="22dp"
        android:layout_marginBottom="12dp" android:text="Criar novo projeto" android:textAllCaps="false"
        android:textStyle="bold" android:textSize="15sp" android:insetTop="0dp" android:insetBottom="0dp"
        android:backgroundTint="@color/brand" app:cornerRadius="19dp" app:icon="@drawable/ic_plus_white"
        app:iconGravity="textStart" android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
