<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="13dp"
    app:cardBackgroundColor="@color/white" app:cardCornerRadius="23dp" app:cardElevation="0dp"
    app:strokeColor="@color/card_border" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/tvProjectMonogram" android:layout_width="46dp" android:layout_height="46dp"
                android:background="@drawable/bg_purple_soft" android:text="P" android:textColor="@color/brand" android:textSize="20sp"
                android:textStyle="bold" android:gravity="center" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="13dp" android:orientation="vertical">
                <TextView android:id="@+id/tvNomeProjeto" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/ink" android:textSize="16sp" android:textStyle="bold" android:maxLines="2"
                    android:ellipsize="end" tools:text="Projeto de engenharia" />
                <TextView android:id="@+id/tvDisciplina" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="3dp" android:textColor="@color/ink_secondary" android:textSize="12sp"
                    android:maxLines="1" android:ellipsize="end" tools:text="Desenvolvimento mobile" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/tvStatusProjeto" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Em andamento" android:textColor="@color/brand" android:textStyle="bold" android:textSize="11sp"
                android:background="@drawable/bg_status_active" android:paddingHorizontal="12dp" android:paddingVertical="7dp" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
            <TextView android:id="@+id/tvEntrega" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/ink_secondary" android:textSize="12sp" tools:text="Entrega 14/11/2026"/>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp" android:background="@color/card_border"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="9dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnConcluido"
                style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="44dp"
                android:text="Concluir" android:textAllCaps="false" android:textSize="13sp" android:textColor="@color/mint"
                app:icon="@drawable/ic_check" app:iconTint="@color/mint" app:iconSize="17dp" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnVerDetalhes"
                style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="44dp"
                android:text="Ver detalhes" android:textAllCaps="false" android:textSize="13sp" android:textColor="@color/brand"
                app:icon="@drawable/ic_arrow_right" app:iconTint="@color/brand" app:iconGravity="textEnd" app:iconSize="17dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
